# Phase 4 — local defaults only. Copy to .env (gitignored). Never commit real secrets.
COMPOSE_PROJECT_NAME=weightgate
POSTGRES_USER=af
POSTGRES_PASSWORD=af_dev_only
POSTGRES_DB=weightgate
AF_DATA_ROOT=./data/tenants
CONTROL_PLANE_PORT=8080
GATEWAY_PORT=8000
OLLAMA_BASE_URL=http://ollama:11434
VLLM_BASE_URL=http://127.0.0.1:8001
# Leave empty to use built-in dual-tenant placeholders from packages/tenantkit/keys.py.
AF_API_KEYS=
AF_INTERNAL_TOKEN=
# Cloud: openai | dashscope | bailian | deepseek
AF_CLOUD_PROVIDER=openai
AF_CLOUD_API_KEY=
AF_CLOUD_BASE_URL=
AF_CLOUD_MODEL=
# Night discount window (informational / cost_estimate only — not a billing API)
AF_CLOUD_NIGHT_START=22:00
AF_CLOUD_NIGHT_END=08:00
AF_CLOUD_NIGHT_DISCOUNT=0.5
AF_CLOUD_NIGHT_TZ=Asia/Shanghai
AF_ROUTE_DEGRADE=1
AF_DOCKER_DRIVER=off
AF_SSH_DRIVER=off
AF_SSH_CONNECT_TIMEOUT=8
AF_REMOTE_AGENT_DIR=~/weightgate-agent
AF_DISK_WARN_RATIO=0.90
AF_ALERT_WEBHOOK_URL=
AF_SLEEP_IDLE_SECONDS=900
